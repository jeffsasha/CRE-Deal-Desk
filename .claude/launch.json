{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dealdesk-demo",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "DEALDESK_DEMO=1 .venv/bin/python manage.py runserver 127.0.0.1:8017 --noreload"
      ],
      "port": 8017
    },
    {
      "name": "dealdesk-local",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "scripts/run_local.sh"
      ],
      "port": 8020
    },
    {
      "name": "dealdesk-demo-auto",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "DEALDESK_DEMO=1 DEALDESK_AUTO_LOGIN=1 .venv/bin/python manage.py runserver 127.0.0.1:8018"
      ],
      "port": 8018
    }
  ]
}