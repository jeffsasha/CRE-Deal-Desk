# Copy to .env (or export) — never commit real values.
# DJANGO_SECRET_KEY=            # optional; generated into var/secret_key if unset
# DJANGO_DEBUG=false            # set false in production
# DJANGO_ALLOWED_HOSTS=dealdesk.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://dealdesk.example.com
# DATABASE_URL=postgres://dealdesk:CHANGE_ME@127.0.0.1:5432/dealdesk   # default: SQLite in var/
# DEALDESK_DATA_DIR=/srv/dealdesk/var                                  # database, private files, backups
# ANTHROPIC_API_KEY=            # enables Claude contract extraction; otherwise the offline pattern extractor runs
# DEALDESK_EXTRACTION_MODEL=claude-opus-5-5
# DEALDESK_OCR_ENGINE=auto      # auto | vision (macOS) | tesseract | none
# EMAIL_HOST=smtp.example.com   # enables email reminders; in-app reminders always work
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=dealdesk@example.com
# DEALDESK_DEMO=1               # demo mode: isolated var-demo/ database and storage
